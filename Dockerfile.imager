FROM --platform=$BUILDPLATFORM tonistiigi/xx:latest AS xx
FROM --platform=$BUILDPLATFORM golang:alpine AS build
ARG TARGETARCH
COPY --from=xx / /
RUN apk add --no-cache pkgconfig
RUN case "$TARGETARCH" in \
      amd64) \
        apk add --no-cache gcc musl-dev vips-dev ;; \
      *) \
        apk add --no-cache clang lld && \
        xx-apk add --no-cache musl-dev shared-mime-info gdk-pixbuf-dev gcc vips-dev ;; \
    esac
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN case "$TARGETARCH" in \
      amd64) \
        CGO_ENABLED=1 go build -trimpath -o /bin/imager ./cmd/imager/ ;; \
      *) \
        export PKG_CONFIG_PATH="$(xx-info sysroot)/usr/share/pkgconfig:$(xx-info sysroot)/usr/lib/pkgconfig" && \
        CGO_ENABLED=1 xx-go build -trimpath -o /bin/imager ./cmd/imager/ ;; \
    esac

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata vips
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --from=build /bin/imager /bin/imager
WORKDIR /app
USER appuser
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD wget -qO- http://localhost:9000/health || exit 1
CMD ["/bin/imager"]
