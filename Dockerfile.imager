FROM golang:alpine AS build
RUN apk add --no-cache --repository https://dl-cdn.alpinelinux.org/alpine/v3.21/community vips-dev gcc musl-dev pkgconfig
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /bin/imager ./cmd/imager/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata vips
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --from=build /bin/imager /bin/imager
WORKDIR /app
USER appuser
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD wget -qO- http://localhost:9000/health || exit 1
CMD ["/bin/imager"]
