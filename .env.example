HTTP_ADDR=:8080

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=linuxer
DB_PASSWORD=
DB_NAME=vendemas_v2
DB_SSLMODE=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=10

# CORS
CORS_ORIGINS=*

# JWT secret for auth
