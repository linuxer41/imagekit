HTTP_ADDR=:8080

# PostgreSQL (single URL instead of individual fields)
DB_URL=postgresql://user:pass@host:5432/dbname?sslmode=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=10

# CORS
CORS_ORIGINS=*

# JWT secret for auth
JWT_SECRET=your-256-bit-secret

# Admin user (seeded on first run)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Cache
CACHE_SIZE_MB=256
CACHE_TTL_SEC=86400

LOG_LEVEL=info
